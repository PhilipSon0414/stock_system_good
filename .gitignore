# ── 민감 정보 (절대 커밋 금지) ──────────────────────────────────────────
# 주의: git .gitignore는 인라인 주석(패턴 뒤 #)을 지원하지 않는다. 주석은 별도 줄에.
# Gmail 앱 비밀번호 포함
email_config.json
# DART API 키 포함
dart_config.json
# 매크로 캐시 (자동 생성)
_macro_cache.json

# ── 대용량 데이터 파일 (로컬 전용) ───────────────────────────────────────
learning_log.json
learning_log_backup_*.json
score_history.json
score_history_backup_*.json
learned_weights.json
intraday_log.json
model_backtest_results.json
timeframe_results.json
selection_tracking_results.json
volume_analysis_results.json

# ── 자동 생성 파일 ────────────────────────────────────────────────────
reports/
logs/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.png
*.DS_Store

# ── 임시/백업 파일 ────────────────────────────────────────────────────
*.bak
*.bak_*
*.tmp
*_backup_*

# ── 모델 가중치는 백업 예외 (사용자 요청 2026-06-16) ─────────────────────
